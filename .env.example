# Copy to .env and fill in. .env is gitignored — never commit it.
#
# NOTE: model names are NOT stored here. README section 9 requires the model
# name to live in the source code and in logging/metadata.json so it can be
# graded. Only credentials and endpoints belong in this file.

# Which provider to call. One of: groq | lmstudio | mistral
LLM_PROVIDER=groq

# Groq — primary. Free tier, no credit card. https://console.groq.com/keys
GROQ_API_KEY=

# Mistral — fallback. Free "Experiment" tier. https://console.mistral.ai
MISTRAL_API_KEY=

# LM Studio — local server, no API key needed.
# Start it with: lms server start
LMSTUDIO_BASE_URL=http://localhost:1234/v1
